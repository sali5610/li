{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "li. ONT-03B static editorial method-fit graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "baseContractVersion",
    "academicContractVersion",
    "demoOnly",
    "boundary",
    "nodes",
    "edges"
  ],
  "properties": {
    "profile": {
      "const": "li-ONT03B-pedagogy-graph-pilot"
    },
    "version": {
      "const": "0.1.0"
    },
    "baseContractVersion": {
      "const": "0.1.0"
    },
    "academicContractVersion": {
      "const": "0.1.0"
    },
    "demoOnly": {
      "const": true
    },
    "boundary": {
      "type": "string",
      "minLength": 10
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUrl",
        "sourceSection",
        "evidenceType",
        "checkedOn"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "sourceSection": {
          "type": "string",
          "minLength": 1
        },
        "evidenceType": {
          "enum": [
            "documented",
            "implemented",
            "editorial",
            "synthetic_fixture"
          ]
        },
        "checkedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "version",
        "reviewState",
        "publishState",
        "visibility",
        "rightsState",
        "aliases",
        "attributes",
        "provenance",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "TechniqueDefinition",
            "TechniqueApplication",
            "Micropractice",
            "IndependentChallenge",
            "Rubric",
            "HintPolicy",
            "RevealGate"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "reviewState": {
          "enum": [
            "proposed",
            "verified",
            "approved"
          ]
        },
        "publishState": {
          "const": "draft"
        },
        "visibility": {
          "const": "public_curated"
        },
        "rightsState": {
          "enum": [
            "first_party",
            "unknown",
            "external_reference"
          ]
        },
        "aliases": {
          "type": "array"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "predicate",
        "from",
        "to",
        "reviewState",
        "visibility",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "reviewState": {
          "enum": [
            "proposed",
            "verified",
            "approved"
          ]
        },
        "visibility": {
          "const": "public_curated"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
