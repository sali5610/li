{
  // Candidate only. NEVER run against production without Human PO approval.
  // First create a dedicated FREE D1 database named li-push-staging
  // and replace its binding ID here. Secrets are Wrangler secrets, never committed.
  "name": "li-push-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "ALLOWED_ORIGIN": "https://sali5610.github.io",
    "NEON_DATA_API_URL": "https://ep-misty-snow-azfrrm3o.apirest.c-3.ap-southeast-1.aws.neon.tech/li/rest/v1"
  },
  "d1_databases": [{
    "binding": "PUSH_DB",
    "database_name": "li-push-staging",
    "database_id": "REPLACE_WITH_STAGING_FREE_D1_DATABASE_ID",
    "migrations_dir": "db"
  }]
}
