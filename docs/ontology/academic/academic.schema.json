{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "li. ONT-03A academic curated graph pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "schemaVersion",
    "baseContractVersion",
    "demoOnly",
    "coverage",
    "boundary",
    "nodes",
    "edges"
  ],
  "properties": {
    "profile": {
      "const": "academic-curated-ontology-pilot"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "baseContractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "demoOnly": {
      "const": true
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "required": [
        "fieldCountInProduct",
        "sampleFields",
        "programmeCoverage",
        "courseRegistryCoverage",
        "independentAcademicReview",
        "lessonRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "fieldCountInProduct": {
          "const": 15
        },
        "sampleFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "programmeCoverage": {
          "const": "NOT_ASSESSED"
        },
        "courseRegistryCoverage": {
          "const": "NOT_ASSESSED"
        },
        "independentAcademicReview": {
          "const": "OPEN"
        },
        "lessonRelease": {
          "const": "NOT_AUTHORIZED"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUrl",
        "sourceSection",
        "evidenceType",
        "checkedOn"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "sourceSection": {
          "type": "string",
          "minLength": 1
        },
        "evidenceType": {
          "enum": [
            "documented",
            "implemented",
            "editorial",
            "synthetic_fixture"
          ]
        },
        "checkedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "version",
        "reviewState",
        "publishState",
        "visibility",
        "rightsState",
        "aliases",
        "attributes",
        "provenance",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "reviewState": {
          "enum": [
            "proposed",
            "verified",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "publishState": {
          "enum": [
            "draft",
            "review_only",
            "not_applicable"
          ]
        },
        "visibility": {
          "const": "public_curated"
        },
        "rightsState": {
          "enum": [
            "first_party",
            "external_reference",
            "unknown"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "locale",
              "text"
            ],
            "properties": {
              "locale": {
                "enum": [
                  "vi",
                  "en"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "predicate",
        "from",
        "to",
        "reviewState",
        "visibility",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 3
        },
        "to": {
          "type": "string",
          "minLength": 3
        },
        "reviewState": {
          "enum": [
            "proposed",
            "verified",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "visibility": {
          "const": "public_curated"
        },
        "provenance": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
