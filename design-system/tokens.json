{
  "schemaVersion": 1,
  "libraryVersion": "0.3.0",
  "status": "runtime tokens source of truth; legacy CSS migration in progress; G2 signoff pending",
  "sources": {
    "notionDesignSystem": "https://app.notion.com/p/41b6cf6db72a81529796dc5d1e134dd1",
    "notionHandoff": "https://app.notion.com/p/4196cf6db72a81f7b000f75783f210b5",
    "implementation": "site/index.html",
    "materialTypography": "https://developer.android.com/develop/ui/compose/designsystems/material3",
    "materialLayoutGrid": "https://m1.material.io/layout/metrics-keylines.html",
    "runtimeFoundations": "site/assets/ui-foundations.css",
    "runtimeTokens": "site/assets/design-tokens.css",
    "tokenGenerator": "tools/generate_design_tokens.py"
  },
  "colors": {
    "paper": "#F3EBDC",
    "paper-2": "#E7DCC3",
    "paper-3": "#D9CBAF",
    "ink": "#272A23",
    "moss": "#243A29",
    "moss-2": "#344B35",
    "forest": "#102218",
    "sage": "#BAC9A7",
    "wood": "#856D4B",
    "muted": "#615F51",
    "rule": "#C3B69B",
    "cream": "#FBF7EB",
    "white": "#FFFFFF",
    "shadow-ink": "#172D20",
    "shadow-wood": "#6B563B"
  },
  "semantic": {
    "activeNavigationPillFill": "#E5D8BA",
    "activeNavigationInk": "#243A29",
    "focusOutline": "3px solid #7E984F",
    "focusOutlineOffsetPx": 3
  },
  "typography": {
    "display": "Crimson Text, Georgia, serif",
    "body": "-apple-system, BlinkMacSystemFont, Segoe UI, Arial, sans-serif",
    "scale": {
      "display": {
        "fontSizePx": 48,
        "lineHeightPx": 56,
        "family": "display",
        "role": "Hero/large display"
      },
      "headline": {
        "fontSizePx": 36,
        "lineHeightPx": 44,
        "family": "display",
        "role": "Page/section heading"
      },
      "titleLarge": {
        "fontSizePx": 28,
        "lineHeightPx": 36,
        "family": "display",
        "role": "Featured editorial title"
      },
      "titleMedium": {
        "fontSizePx": 24,
        "lineHeightPx": 32,
        "family": "display",
        "role": "Card title"
      },
      "titleSmall": {
        "fontSizePx": 20,
        "lineHeightPx": 28,
        "family": "display",
        "role": "Small heading"
      },
      "bodyLarge": {
        "fontSizePx": 18,
        "lineHeightPx": 28,
        "family": "body",
        "role": "Long reading/lead where needed"
      },
      "body": {
        "fontSizePx": 16,
        "lineHeightPx": 24,
        "family": "body",
        "role": "Default paragraphs, input and primary CTA"
      },
      "support": {
        "fontSizePx": 14,
        "lineHeightPx": 20,
        "family": "body",
        "role": "Secondary descriptions and supporting controls"
      },
      "caption": {
        "fontSizePx": 12,
        "lineHeightPx": 16,
        "family": "body",
        "role": "Nonessential metadata, eyebrow only"
      }
    },
    "readabilityRule": "No 9-11px UI copy. 12px only for optional metadata; essential instructional text >=14px, body 16px. Heading color/Crimson retained, no wholesale Roboto switch."
  },
  "shape": {
    "ordinaryControlRadiusPx": 0,
    "exceptions": [
      "selected top/bottom navigation sand pill",
      "Lao Ly rounded speech bubble",
      "natural illustration shapes"
    ]
  },
  "interaction": {
    "minimumIntendedTapTargetPx": 48,
    "respectReducedMotion": true,
    "selectedNavAriaCurrent": "page",
    "nativeTapHighlightOnIconControls": false
  },
  "layout": {
    "homeHero": "full bleed",
    "readingViews": "bounded editorial container",
    "homePrimaryActionsInOrder": [
      "Lưu",
      "Đào sâu"
    ],
    "reviewViewportWidthsPx": [
      320,
      375,
      390,
      402,
      600,
      820,
      1440
    ]
  },
  "quality": {
    "g2Approved": false,
    "physicalDeviceQAVerified": false,
    "contrastCertified": false,
    "persistenceGuarantees": false,
    "visualRegressionScreenshotVerified": false,
    "allLegacySpacingConformant": false,
    "humanTypographySpacingSignoff": false,
    "consolidationReviewedOnDevice": false,
    "allRuntimeColorLiteralsTokenized": false,
    "artGradientColorsReviewedOnDevice": false
  },
  "spacing": {
    "baseUnitPx": 4,
    "primaryRhythmPx": 8,
    "valuesPx": [
      0,
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64,
      80,
      96
    ],
    "aliasesPx": {
      "hairlineGap": 4,
      "inlineGap": 8,
      "labelToContent": 12,
      "controlInsetY": 12,
      "controlInsetX": 16,
      "mobilePageGutter": 16,
      "tabletPageGutter": 24,
      "desktopPageGutter": 40,
      "mobileCardPadding": 20,
      "desktopCardPadding": 24,
      "stackGap": 24,
      "mobileSectionGap": 24,
      "desktopSectionGap": 32,
      "wideSectionGap": 40,
      "betweenMajorSections": 48,
      "minimumTouchTarget": 48
    },
    "requiredRule": "Every spacing token and every new margin/padding/gap literal in canonical CSS must be a multiple of 4px; layout sizes and artwork coordinates are separate.",
    "transition": "Color/type/space runtime CSS tokens generated from design-system/tokens.json; older inline layout and illustration geometry are migrated incrementally with source and responsive verification."
  },
